# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI APIs
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_OLLAMA_API_KEY=

# Stripe (public key only — secret key goes in Supabase Edge Function secrets)
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# EmailJS
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# VITE_EMAILJS_PRIVATE_KEY should NOT be in frontend env — move to a server function
